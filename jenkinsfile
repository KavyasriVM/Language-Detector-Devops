pipeline {
    agent any
    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    docker.build('language-detection:latest')
                }
            }
        }
        stage('Run Docker Container') {
            steps {
                script {
                    // Stop existing container if running
                    sh "docker ps -q --filter 'name=language-detection' | xargs -r docker stop"
                    sh "docker ps -a -q --filter 'name=language-detection' | xargs -r docker rm"
                    
                    docker.image('language-detection:latest').run('-d -p 5000:5000 --name language-detection')
                }
            }
        }
    }
}
